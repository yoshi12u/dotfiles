                "description": "Ctrl+D: Delete character forward (except in terminal apps)",
                "conditions": [
                  {
                    "bundle_identifiers": [
                      "^com\\.apple\\.Terminal$",
                      "^com\\.googlecode\\.iterm2$",
                      "^com\\.microsoft\\.VSCode$",
                      "^com\\.github\\.wez\\.wezterm$",
                      "^com\\.todesktop\\.230313mzl4w4u92$"
